FROM python:3.13-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 JOB_ROOT=/tmp/rallymirror
WORKDIR /app
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt && useradd --create-home app
COPY src/deployment ./src/deployment
RUN touch src/__init__.py && chown -R app:app /app
USER app
CMD ["sh", "-c", "exec uvicorn src.deployment.api:create_app --factory --host 0.0.0.0 --port ${PORT:-8000} --no-access-log"]
