# CPU API secrets (Render). Never put these in frontend JavaScript.
JOB_BACKEND=runpod
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE
APP_ACCESS_TOKEN=REPLACE_WITH_RANDOM_TEAM_KEY
WORKER_SECRET=REPLACE_WITH_RANDOM_CALLBACK_SECRET
API_BASE_URL=https://YOUR-API.onrender.com
RUNPOD_ENDPOINT_ID=REPLACE
RUNPOD_API_KEY=REPLACE
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=rallymirror-private
AWS_ACCESS_KEY_ID=REPLACE
AWS_SECRET_ACCESS_KEY=REPLACE
MAX_UPLOAD_BYTES=209715200
MAX_VIDEO_SECONDS=60
JOB_TIMEOUT_SECONDS=1800

# GPU worker: set only API_BASE_URL, WORKER_SECRET, S3_ENDPOINT_URL, S3_BUCKET,
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, INFERENCE_DEVICE=cuda and limits.
# Do not give GPU workers DATABASE_URL, RUNPOD_API_KEY or APP_ACCESS_TOKEN.
