# Run both API and worker from repository root with the SAME environment.
JOB_BACKEND=local
JOB_ROOT=outputs/deployment
# Optional shared team key (recommended if binding beyond 127.0.0.1).
APP_ACCESS_TOKEN=
INFERENCE_DEVICE=auto
MAX_UPLOAD_BYTES=209715200
MAX_VIDEO_SECONDS=60
JOB_TIMEOUT_SECONDS=1800
