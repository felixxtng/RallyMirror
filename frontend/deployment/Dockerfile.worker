FROM python:3.13-slim-bookworm
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    INFERENCE_DEVICE=cuda \
    MPLBACKEND=Agg \
    YOLO_CONFIG_DIR=/tmp/ultralytics \
    OMP_NUM_THREADS=2 \
    MKL_NUM_THREADS=2 \
    OPENBLAS_NUM_THREADS=2
WORKDIR /app/backend
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ffmpeg libglib2.0-0 libgl1 libegl1 libgomp1 libportaudio2 \
    && rm -rf /var/lib/apt/lists/*
ARG TORCH_VERSION=2.11.0
ARG TORCHVISION_VERSION=0.26.0
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
COPY backend/requirements-api.txt backend/requirements-worker.txt ./
RUN pip install --no-cache-dir \
       torch==${TORCH_VERSION} torchvision==${TORCHVISION_VERSION} \
       --index-url ${TORCH_INDEX_URL} \
    && pip install --no-cache-dir -r requirements-worker.txt
# MediaPipe's native task runtime links GLES even when inference uses the CPU.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgles2 \
    && rm -rf /var/lib/apt/lists/*
COPY backend/src ./src
COPY backend/configs ./configs
COPY backend/models ./models
RUN python -m src.deployment.preflight \
    && useradd --uid 10001 --create-home app \
    && mkdir -p /data/jobs \
    && chown app:app /data/jobs
USER app
CMD ["sh", "-c", "python -m src.deployment.preflight && exec python -u -m src.deployment.runpod_worker"]
