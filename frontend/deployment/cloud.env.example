# Reference configuration for the existing asynchronous cloud backend.
# These are placeholders, not working services or credentials.
# A cloud API needs PostgreSQL, a private S3-compatible/R2 bucket and HTTPS.
JOB_BACKEND=runpod
JOB_ROOT=/data/jobs
FRONTEND_DIST=/app/dist
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/rallymirror
APP_ACCESS_TOKEN=REPLACE_WITH_A_PRIVATE_TEAM_ACCESS_KEY
WORKER_SECRET=REPLACE_WITH_A_SEPARATE_PRIVATE_WORKER_SECRET
API_BASE_URL=https://YOUR_API_HOST
RUNPOD_ENDPOINT_ID=REPLACE_WITH_YOUR_ENDPOINT_ID
RUNPOD_API_KEY=REPLACE_WITH_YOUR_SERVER_SIDE_API_KEY
S3_BUCKET=REPLACE_WITH_YOUR_PRIVATE_BUCKET
S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=REPLACE_WITH_YOUR_SCOPED_STORAGE_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_SCOPED_STORAGE_SECRET
MAX_UPLOAD_BYTES=209715200
MAX_VIDEO_SECONDS=60
JOB_TIMEOUT_SECONDS=1800
